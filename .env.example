# GlobalPolicyInfra secrets template.
#
# Copy this file to `.env` in the repository root and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — real keys must never enter git.
#
# Secrets only (loaded as environment variables). data_root does NOT belong
# here — use `gpi init` or POLICY_DATA_ROOT.

# congress.gov API v3 key (free registration: https://api.congress.gov/sign-up/)
# used by the USA bills source adapter
CONGRESS_API_KEY=
